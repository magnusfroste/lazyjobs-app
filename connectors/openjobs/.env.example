# OpenJobs API Configuration
OPENJOBS_API_URL=http://localhost:8080

# LazyJobs Ingest Configuration
INGEST_URL=https://arqugyvmegxonaerjbzd.supabase.co/functions/v1/ingest-jobs
CONNECTOR_API_KEY=your-connector-api-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Service role key for checking existing jobs (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Enrichment (optional)
ENABLE_ENRICHMENT=true
ENRICHMENT_URL=https://agent.froste.eu/webhook/enrich-jobs

# Batch Processing Settings
BATCH_SIZE=50  # Process 50 jobs at a time for AI enrichment
BATCH_DELAY_MS=1000  # 1 second delay between batches

# Scheduling Options (choose ONE):

# Option 1: Cron-based (RECOMMENDED for daily syncs)
CRON_SCHEDULE=0 7 * * *  # Daily at 7:00 AM
# Examples:
#   0 7 * * *     = Daily at 7:00 AM
#   0 7,19 * * *  = Twice daily at 7 AM and 7 PM
#   */6 * * * *   = Every 6 hours

# Option 2: Interval-based (for testing/development)
# RUN_CONTINUOUSLY=true
# SYNC_INTERVAL_HOURS=6
