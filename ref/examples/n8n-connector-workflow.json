{
  "name": "JobMatch Connector - Example",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [250, 300],
      "id": "schedule-trigger"
    },
    {
      "parameters": {
        "url": "https://api.example.com/jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "name": "Fetch Jobs from API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 300],
      "id": "fetch-jobs"
    },
    {
      "parameters": {
        "functionCode": "// Transform jobs to JobMatch format\nconst jobs = items.map(item => {\n  const job = item.json;\n  return {\n    json: {\n      external_id: `example_${job.id}`,\n      title: job.title,\n      company: job.company,\n      description: job.description,\n      location: job.location,\n      salary_min: job.salary_min,\n      salary_max: job.salary_max,\n      is_remote: job.remote === true,\n      employment_type: job.type,\n      required_skills: job.skills || [],\n      experience_level: job.level,\n      url: job.url,\n      posted_at: job.posted_date || new Date().toISOString()\n    }\n  };\n});\n\nreturn jobs;"
      },
      "name": "Transform Jobs",
      "type": "n8n-nodes-base.function",
      "position": [650, 300],
      "id": "transform-jobs"
    },
    {
      "parameters": {
        "functionCode": "// Batch jobs into groups of 50\nconst batchSize = 50;\nconst allJobs = items.map(item => item.json);\nconst batches = [];\n\nfor (let i = 0; i < allJobs.length; i += batchSize) {\n  batches.push({\n    json: {\n      jobs: allJobs.slice(i, i + batchSize)\n    }\n  });\n}\n\nreturn batches;"
      },
      "name": "Batch Jobs",
      "type": "n8n-nodes-base.function",
      "position": [850, 300],
      "id": "batch-jobs"
    },
    {
      "parameters": {
        "url": "https://arqugyvmegxonaerjbzd.supabase.co/functions/v1/ingest-jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_CONNECTOR_API_KEY"
            }
          ]
        },
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "jsonParameters": true,
        "options": {}
      },
      "name": "Submit to JobMatch",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1050, 300],
      "id": "submit-jobs"
    },
    {
      "parameters": {
        "functionCode": "// Log results\nconst results = items.map(item => item.json);\nconsole.log('JobMatch submission results:', results);\nreturn items;"
      },
      "name": "Log Results",
      "type": "n8n-nodes-base.function",
      "position": [1250, 300],
      "id": "log-results"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Fetch Jobs from API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Jobs from API": {
      "main": [
        [
          {
            "node": "Transform Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transform Jobs": {
      "main": [
        [
          {
            "node": "Batch Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Batch Jobs": {
      "main": [
        [
          {
            "node": "Submit to JobMatch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Submit to JobMatch": {
      "main": [
        [
          {
            "node": "Log Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
