VITE_SUPABASE_URL=https://arqugyvmegxonaerjbzd.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_N8N_CV_WEBHOOK_URL=https://your-n8n-instance.com/webhook/cv-process

# Qdrant Semantic Search (Optional)
# Frontend (React app) - used by browser
VITE_QDRANT_URL=https://n8n-qdrant.katsu6.easypanel.host

# Backend (Supabase edge functions) - set via: supabase secrets set QDRANT_URL=...
# QDRANT_URL is NOT needed in .env (it's a Supabase secret)
# Only needed if running edge functions locally

# OpenAI for embeddings (required if ENABLE_QDRANT=true)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Sentry Error Tracking (Optional - for production)
# Get your DSN from https://sentry.io (free tier available)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Jooble Job API (Optional - for job scraping)
# Get your key from https://jooble.org/api/about
JOOBLE_API_KEY=your-jooble-api-key-here

# ============================================
# FEATURE FLAGS
# ============================================
# Feature flags are managed in Supabase app_settings table (not env vars!)
# To toggle features: UPDATE app_settings SET value = ... WHERE key = 'features'
# This allows changing features without rebuild/redeploy
#
# Available features in app_settings:
# - ai_matching: Enable AI-powered job matching
# - ai_matching_premium: Gate AI matching behind paywall
# - ai_matching_show_stats: Show comparison stats
# - application_assistant: Enable CV/cover letter generation
# - application_assistant_premium: Gate assistant behind paywall
# - qdrant_enabled: Enable semantic search